# ── Database ─────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/moodle
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Connection pool sizing (optional; sensible defaults are applied).
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5

# ── JWT ──────────────────────────────────────────────
# MUST be a long, random, secret value of at least 32 bytes. Generate one with, e.g.:
#   openssl rand -base64 48
# The application refuses to start with a weak or placeholder secret.
JWT_SECRET=change-me-to-a-random-value-at-least-32-bytes-long

# ── Application URLs ─────────────────────────────────
# Public URL of the Angular front-end (used for OAuth redirect + password-reset links).
APP_FRONTEND_URL=http://localhost:4200
# Comma-separated list of origins allowed to call the API (CORS). No wildcards in production.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Base URL the backend is reached at (used to build OAuth2 redirect URIs).
OAUTH_BASE_URL=http://localhost:8080

# ── Google OAuth2 ────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Facebook OAuth2 ──────────────────────────────────
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ── Mail (Gmail SMTP) ───────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ── Runtime / scalability (optional) ─────────────────
# TOMCAT_MAX_THREADS=200
# FORWARD_HEADERS_STRATEGY=framework   # set to "none" if NOT behind a reverse proxy
# JPA_SHOW_SQL=false
