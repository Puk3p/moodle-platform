# Copy to deploy/.env and fill in for anything but local development.
MYSQL_ROOT_PASSWORD=
ACADEMIC_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
MESSAGING_DB_PASSWORD=
PROGRESS_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=
# identity-service's pre-2FA challenge tokens; at least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Service credentials for identity-service's token endpoint, e.g. `openssl rand -hex 32` each
INTERNAL_CLIENT_GATEWAY_SECRET=
INTERNAL_CLIENT_ACADEMIC_SECRET=
INTERNAL_CLIENT_MESSAGING_SECRET=
INTERNAL_CLIENT_PROGRESS_SECRET=
INTERNAL_CLIENT_ASSESSMENT_SECRET=
# Optional RS256 key pair for internal tokens (PEM, PKCS#8 private / X.509 public). Left empty,
# identity-service generates one on its first start and keeps it in its database; set both to keep
# the private key out of the database
INTERNAL_JWT_PRIVATE_KEY=
INTERNAL_JWT_PUBLIC_KEY=
# Behind HTTPS: true, and the gateway must read the __Host- cookie
APP_SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-mdl_session
# Only the reverse proxy (nginx) may report client addresses to the gateway, e.g. the Docker network
TRUSTED_PROXIES=127\.0\.0\.1|172\.(1[6-9]|2[0-9]|3[01])\..*
# identity-service: which proxies Tomcat trusts for X-Forwarded-For; the private-network default
# is right
IDENTITY_TRUSTED_PROXIES=10\.\d+\.\d+\.\d+|172\.(1[6-9]|2[0-9]|3[01])\.\d+\.\d+|192\.168\.\d+\.\d+|127\.\d+\.\d+\.\d+
PUBLIC_BASE_URL=https://moodle.example.org
APP_FRONTEND_URL=https://moodle.example.org
APP_CORS_ALLOWED_ORIGINS=https://moodle.example.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
# Images from a registry instead of building here (set by the deploy workflow)
IMAGE_PREFIX=ghcr.io/<owner>/moodle
IMAGE_TAG=<commit sha>
# Where the gateway listens on the host; the reverse proxy forwards the API there
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=8091
# Memory cap per Java service (its heap is 70% of it)
JAVA_SERVICE_MEMORY=1g
