<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Lombok-generated accessors and records handing out their own fields -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- JPA entities are mutable by design -->
    <Match>
        <Package name="moodlev2.assessment.infrastructure.persistence.entity"/>
    </Match>
    <!-- Request/response records -->
    <Match>
        <Package name="~moodlev2\.assessment\.web\..*\.dto"/>
    </Match>
</FindBugsFilter>
