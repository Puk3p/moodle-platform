#!/usr/bin/env bash
set -euo pipefail

echo "╔══════════════════════════════════════╗"
echo "║         PRE-PUSH CHECKS              ║"
echo "╚══════════════════════════════════════╝"

# ── 1. Services: formatting, unit tests and SpotBugs per changed module ─
# The Maven modules (each service is its own) that hold these changed Java files.
changed_modules() {
    echo "$1" | { grep '\.java$' || true; } | while read -r f; do
        case "$f" in
            services/*/* | edge/*/*) echo "$f" | cut -d/ -f1-2 ;;
            e2e/*) echo "e2e" ;;
        esac
    done | sort -u
}

# Builds outside ./target when set (e.g. a checkout in an iCloud-synced folder).
BUILD_ROOT_ARG=${MOODLE_BUILD_ROOT:+-Dmoodle.build.root=$MOODLE_BUILD_ROOT}
MODULES=$(changed_modules "$(git diff --name-only HEAD~1 HEAD 2>/dev/null || true)")

if [[ -n "$MODULES" ]]; then
    JAVA_VER=$(java -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"')
    if [[ "$JAVA_VER" -ge 21 ]] 2>/dev/null; then
        for m in $MODULES; do
            # Integration tests need Docker (Testcontainers); CI runs them.
            echo "→ $m: Spotless, unit tests, SpotBugs..."
            ./mvnw -q -f "$m/pom.xml" verify -DskipITs $BUILD_ROOT_ARG || {
                echo "✖ $m failed. Formatting: ./mvnw -f $m/pom.xml spotless:apply"
                exit 1
            }
        done
        echo "✓ Services passed."
    else
        echo "⚠ Skipping service checks (local JDK $JAVA_VER < 21). CI will run them."
    fi
fi

# ── 2. Frontend: Build + test ────────────────────────────
TS_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -E '\.(ts|html|scss)$' | grep '^frontend/' || true)

if [[ -n "$TS_FILES" ]]; then
    if [[ -d "frontend/node_modules" ]]; then
        echo "→ Running frontend build..."
        (cd frontend && npx ng build --configuration production) || {
            echo "✖ Frontend build failed."
            exit 1
        }
        echo "✓ Frontend build passed."

        echo "→ Running frontend tests..."
        (cd frontend && npx ng test --watch=false --browsers=ChromeHeadless) || {
            echo "✖ Frontend tests failed."
            exit 1
        }
        echo "✓ Frontend tests passed."
    else
        echo "⚠ Skipping frontend checks (node_modules not installed). CI will run them."
    fi
fi

echo ""
echo "✓ All pre-push checks passed. Pushing..."
